    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Recupera los datos originales de la fila de la tabla.\n// El nodo anterior debe llamarse exactamente \"Leer productos\".\nconst producto = $('Leer productos').item.json;\n\nconst nombreProducto =\n  producto[\"nombre_Producto\"] ??\n  producto.nombre ??\n  \"Producto sin nombre\";\n\nconst sitioDescuento =\n  producto[\"sitio\"] ??\n  \"Sitio no informado\";\n\nconst statusCode = Number($json.statusCode ?? 200);\n\n// Dependiendo de la configuración del HTTP Request,\n// el HTML puede encontrarse en html, body o data.\nconst html = String(\n  $json.html ??\n  $json.body ??\n  $json.data ??\n  ''\n);\n\n/**\n * Convierte diferentes formatos de precios en un número.\n *\n * Ejemplos:\n * \"$ 25.999,90\" → 25999.90\n * \"25999.90\" → 25999.90\n * \"25999\" → 25999\n */\nfunction normalizarPrecio(valor) {\n  if (typeof valor === 'number') {\n    return valor;\n  }\n\n  if (valor === null || valor === undefined) {\n    return NaN;\n  }\n\n  let texto = String(valor)\n    .trim()\n    .replace(/[^\\d,.-]/g, '');\n\n  if (!texto) {\n    return NaN;\n  }\n\n  const ultimaComa = texto.lastIndexOf(',');\n  const ultimoPunto = texto.lastIndexOf('.');\n\n  // Ejemplo argentino: 25.999,90\n  if (ultimaComa > -1 && ultimoPunto > -1) {\n    if (ultimaComa > ultimoPunto) {\n      texto = texto\n        .replace(/\\./g, '')\n        .replace(',', '.');\n    } else {\n      // Ejemplo internacional: 25,999.90\n      texto = texto.replace(/,/g, '');\n    }\n  } else if (ultimaComa > -1) {\n    const decimales = texto.length - ultimaComa - 1;\n\n    if (decimales === 2) {\n      texto = texto.replace(',', '.');\n    } else {\n      texto = texto.replace(/,/g, '');\n    }\n  } else if (ultimoPunto > -1) {\n    const partes = texto.split('.');\n\n    // Ejemplo: 25.999\n    if (\n      partes.length > 2 ||\n      (partes.length === 2 && partes[1].length === 3)\n    ) {\n      texto = partes.join('');\n    }\n  }\n\n  return Number(texto);\n}\n\n/**\n * Busca recursivamente un objeto Schema.org de tipo Product.\n */\nfunction encontrarProducto(valor) {\n  if (!valor || typeof valor !== 'object') {\n    return null;\n  }\n\n  const tipo = valor['@type'];\n  const tipos = Array.isArray(tipo) ? tipo : [tipo];\n\n  const esProducto = tipos.some((item) =>\n    String(item || '').toLowerCase().endsWith('product')\n  );\n\n  if (esProducto) {\n    return valor;\n  }\n\n  for (const hijo of Object.values(valor)) {\n    const encontrado = encontrarProducto(hijo);\n\n    if (encontrado) {\n      return encontrado;\n    }\n  }\n\n  return null;\n}\n\n/**\n * Selecciona una oferta que tenga un precio.\n */\nfunction encontrarOferta(ofertas) {\n  if (!ofertas) {\n    return null;\n  }\n\n  const lista = Array.isArray(ofertas) ? ofertas : [ofertas];\n\n  return (\n    lista.find((oferta) =>\n      oferta &&\n      (\n        oferta.price !== undefined ||\n        oferta.lowPrice !== undefined ||\n        oferta.priceSpecification\n      )\n    ) ||\n    lista[0] ||\n    null\n  );\n}\n\nlet precioSinProcesar = null;\nlet moneda = 'ARS';\nlet nombreDetectado = producto.nombre || '';\n\nif (statusCode < 400 && html) {\n  // Busca bloques JSON-LD dentro de la página.\n  const bloques = [\n    ...html.matchAll(\n      /<script\\b[^>]*type=[\"']application\\/ld\\+json[\"'][^>]*>([\\s\\S]*?)<\\/script>/gi\n    ),\n  ];\n\n  for (const bloque of bloques) {\n    let contenido = bloque[1].trim();\n\n    contenido = contenido\n      .replace(/^<!--/, '')\n      .replace(/-->$/, '')\n      .trim();\n\n    try {\n      const jsonLd = JSON.parse(contenido);\n      const datosProducto = encontrarProducto(jsonLd);\n\n      if (!datosProducto) {\n        continue;\n      }\n\n      const oferta = encontrarOferta(datosProducto.offers);\n\n      const especificacionPrecio = Array.isArray(\n        oferta?.priceSpecification\n      )\n        ? oferta.priceSpecification[0]\n        : oferta?.priceSpecification;\n\n      precioSinProcesar =\n        oferta?.price ??\n        oferta?.lowPrice ??\n        especificacionPrecio?.price ??\n        null;\n\n      moneda =\n        oferta?.priceCurrency ??\n        especificacionPrecio?.priceCurrency ??\n        moneda;\n\n      nombreDetectado =\n        producto.nombre ||\n        datosProducto.name ||\n        nombreDetectado;\n\n      if (precioSinProcesar !== null) {\n        break;\n      }\n    } catch (error) {\n      // Algunos bloques JSON-LD no son válidos.\n      // Continuamos buscando en los demás.\n    }\n  }\n}\n\n// Segunda opción: buscar etiquetas meta con el precio.\nif (precioSinProcesar === null && statusCode < 400) {\n  const patronesMeta = [\n    /<meta[^>]+(?:property|itemprop)=[\"'](?:product:price:amount|price)[\"'][^>]+content=[\"']([^\"']+)[\"']/i,\n    /<meta[^>]+content=[\"']([^\"']+)[\"'][^>]+(?:property|itemprop)=[\"'](?:product:price:amount|price)[\"']/i,\n  ];\n\n  for (const patron of patronesMeta) {\n    const coincidencia = html.match(patron);\n\n    if (coincidencia?.[1]) {\n      precioSinProcesar = coincidencia[1];\n      break;\n    }\n  }\n}\n\nconst precioActual = normalizarPrecio(precioSinProcesar);\n\nconst precioEncontrado =\n  Number.isFinite(precioActual) &&\n  precioActual > 0;\n\nconst precioAnteriorVacio =\n  producto.ultimo_precio === null ||\n  producto.ultimo_precio === undefined ||\n  producto.ultimo_precio === '';\n\nconst precioAnterior = precioAnteriorVacio\n  ? null\n  : Number(producto.ultimo_precio);\n\nconst bajo =\n  precioEncontrado &&\n  Number.isFinite(precioAnterior) &&\n  precioAnterior > 0 &&\n  precioActual < precioAnterior;\n\nconst diferencia = bajo\n  ? Number((precioAnterior - precioActual).toFixed(2))\n  : 0;\n\nconst porcentajeBaja = bajo\n  ? Number(\n      (\n        ((precioAnterior - precioActual) / precioAnterior) *\n        100\n      ).toFixed(2)\n    )\n  : 0;\n\nlet mensajeError = '';\n\nif (statusCode >= 400) {\n  mensajeError = `La página respondió con HTTP ${statusCode}`;\n} else if (!precioEncontrado) {\n  mensajeError =\n    'No se encontró un precio en el HTML de esta página';\n}\n\nreturn {\n  json: {\n    ...producto,\n    nombre_Producto: nombreProducto,\n    sitio: sitioDescuento,\n    precio_anterior: precioAnterior,\n    precio_actual: precioEncontrado ? precioActual : null,\n    moneda,\n    bajo,\n    diferencia,\n    porcentaje_baja: porcentajeBaja,\n    precio_encontrado: precioEncontrado,\n    ultima_revision: new Date().toISOString(),\n    ultimo_error: mensajeError,\n  },\n};"
      },
